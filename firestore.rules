rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data) {
      // Allow any document that has a freeUsesCount integer
      return data.get('freeUsesCount', 0) is int;
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if isValidId(userId);
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data);
    }
  }
}
